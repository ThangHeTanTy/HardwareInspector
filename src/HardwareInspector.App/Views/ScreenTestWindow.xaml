<Window x:Class="HardwareInspector.App.Views.ScreenTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra màn hình"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="Black" Cursor="None"
        KeyDown="OnKeyDown" MouseLeftButtonDown="OnClick">

  <Grid>
    <!-- Lớp nền: đổi theo từng bài kiểm tra -->
    <Rectangle x:Name="Backdrop" Fill="Black" />

    <!-- Lưới ô vuông dùng để soi điểm chết theo từng vùng -->
    <UniformGrid x:Name="GridOverlay" Rows="6" Columns="8" Visibility="Collapsed">
      <UniformGrid.Resources>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="#40FFFFFF" />
          <Setter Property="BorderThickness" Value="0.5" />
        </Style>
      </UniformGrid.Resources>
    </UniformGrid>

    <!-- Bảng hướng dẫn, ẩn đi khi đang soi -->
    <Border x:Name="HelpPanel" Background="#CC0F1115" CornerRadius="10" Padding="26"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
      <StackPanel>
        <TextBlock x:Name="StepTitle" Text="Kiểm tra màn hình" FontSize="20" FontWeight="SemiBold"
                   Foreground="White" Margin="0,0,0,10" />
        <TextBlock x:Name="StepHint" Foreground="#C8CCD4" TextWrapping="Wrap" FontSize="14"
                   Text="Tắt bớt đèn phòng trước khi bắt đầu. Nhìn sát màn hình khoảng 30 cm và quét mắt theo từng vùng." />
        <TextBlock Foreground="#8A8F98" Margin="0,16,0,0" FontSize="12.5" TextWrapping="Wrap"
                   Text="Chuột trái hoặc phím Cách: bài kế tiếp · Backspace: bài trước · G: bật/tắt lưới soi vùng · H: ẩn bảng này · Esc: thoát" />
        <TextBlock x:Name="StepCounter" Foreground="#8A8F98" Margin="0,12,0,0" FontSize="12" />
        <TextBlock x:Name="TargetLabel" Foreground="#4C8DFF" Margin="0,4,0,0" FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
