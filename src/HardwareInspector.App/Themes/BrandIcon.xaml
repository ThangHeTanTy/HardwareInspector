<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icon dạng vector.

    Không dùng file .ico làm nguồn cho <Image>: bộ giải mã ICO của WPF chọn một khung
    bitmap có sẵn rồi co giãn lên kích thước yêu cầu, và khung nó chọn thường không
    khớp với kích thước hiển thị nên ảnh bị vỡ. Đặt BitmapScalingMode cũng không cứu được,
    vì vấn đề nằm ở chỗ dữ liệu nguồn thiếu điểm ảnh chứ không phải ở thuật toán nội suy.

    Vẽ lại bằng hình học nên sắc nét ở mọi kích thước và mọi mức thu phóng DPI.
    File .ico vẫn giữ nguyên vai trò của nó: icon cho .exe và cho thanh tiêu đề cửa sổ,
    hai chỗ mà Windows bắt buộc phải nhận bitmap.

    Hệ toạ độ 512x512, khớp với Assets/app-icon.svg. Sửa một bên thì sửa cả bên kia.
  -->
  <DrawingImage x:Key="AppIconDrawing">
    <DrawingImage.Drawing>
      <DrawingGroup>

        <!-- Khung trong suốt để ghim khuôn 512x512, giữ tỉ lệ và lề đồng nhất -->
        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,512,512" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Tóc xù: cụm hình tròn chồng nhau, chừa đỉnh đầu hói -->
        <GeometryDrawing Brush="#F4A259">
          <GeometryDrawing.Geometry>
            <GeometryGroup FillRule="Nonzero">
              <EllipseGeometry Center="76,240" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="58,300" RadiusX="58" RadiusY="58" />
              <EllipseGeometry Center="80,358" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="436,240" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="454,300" RadiusX="58" RadiusY="58" />
              <EllipseGeometry Center="432,358" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="140,168" RadiusX="44" RadiusY="44" />
              <EllipseGeometry Center="372,168" RadiusX="44" RadiusY="44" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Khuôn mặt -->
        <GeometryDrawing Brush="#FFDCC0">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="256,300" RadiusX="168" RadiusY="168" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Mắt không đeo kính -->
        <GeometryDrawing Brush="#232833">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="352,278" RadiusX="18" RadiusY="18" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Miệng cười -->
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#232833" Thickness="22" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M204,400 Q278,462 352,400" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Mũi hề -->
        <GeometryDrawing Brush="#E5544B">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="278,350" RadiusX="42" RadiusY="42" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Mặt kính: xanh mờ, alpha 38h tương đương 22% -->
        <GeometryDrawing Brush="#384C8DFF">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="188,272" RadiusX="88" RadiusY="88" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Vành kính -->
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#4C8DFF" Thickness="24" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="188,272" RadiusX="88" RadiusY="88" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Con ngươi được kính phóng to -->
        <GeometryDrawing Brush="#232833">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="188,272" RadiusX="34" RadiusY="34" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Bản logo đầy đủ: thêm mũ và dây đeo kính, dùng cho màn hình giới thiệu -->
  <DrawingImage x:Key="AppLogoDrawing">
    <DrawingImage.Drawing>
      <DrawingGroup>

        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,512,512" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#F4A259">
          <GeometryDrawing.Geometry>
            <GeometryGroup FillRule="Nonzero">
              <EllipseGeometry Center="76,248" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="58,308" RadiusX="58" RadiusY="58" />
              <EllipseGeometry Center="80,366" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="436,248" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="454,308" RadiusX="58" RadiusY="58" />
              <EllipseGeometry Center="432,366" RadiusX="50" RadiusY="50" />
              <EllipseGeometry Center="140,182" RadiusX="44" RadiusY="44" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Mũ hề -->
        <GeometryDrawing Brush="#E5544B">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M242,164 L348,192 L322,64 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2FBF71">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="322,56" RadiusX="26" RadiusY="26" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#FFDCC0">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="256,308" RadiusX="168" RadiusY="168" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#232833">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="352,286" RadiusX="18" RadiusY="18" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#232833" Thickness="22" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M204,408 Q278,470 352,408" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#E5544B">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="278,358" RadiusX="42" RadiusY="42" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Dây đeo kính -->
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#3A6FD8" Thickness="11" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M170,364 Q134,428 152,474" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#3A6FD8">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="152,476" RadiusX="17" RadiusY="17" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#384C8DFF">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="188,280" RadiusX="88" RadiusY="88" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#4C8DFF" Thickness="24" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="188,280" RadiusX="88" RadiusY="88" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#232833">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="188,280" RadiusX="34" RadiusY="34" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
